<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>{"timestamp":"%d{ISO8601}","level":"%level","logger":"%logger{36}","thread":"%thread","message":"%replace(%msg){'"','\\"'}"}%n</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

    <logger name="com.knowledgegraph.core" level="DEBUG"/>
    <!-- Spring Data's generated mapping queries use Neo4j's deprecated id() projection.
         At bulk scale Neo4j emits the same warning for every request, producing millions of
         log lines. The application queries use stable domain IDs, so suppress only this
         repetitive framework-generated warning until Spring Data changes its projection. -->
    <logger name="org.springframework.data.neo4j.cypher.deprecation" level="ERROR"/>
</configuration>

